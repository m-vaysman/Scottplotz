<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>Scottplotz</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <PublishDir>$(MSBuildProjectDirectory)\..\artifacts\publish\win-x64\</PublishDir>
    <DefineConstants>ProductVersion=$(Version)</DefineConstants>
    <SuppressIces>ICE38;ICE57</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Firewall.wixext" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <BindPath Include="$(PublishDir)" BindName="publish" />
  </ItemGroup>

  <Target Name="PublishApp" BeforeTargets="BeforeBuild">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\src\Scottplotz.Tray\Scottplotz.Tray.csproj"
             Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(PublishDir);Version=$(Version)" />
  </Target>
</Project>
