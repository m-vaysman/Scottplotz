@host = http://localhost:5240

### Health
GET {{host}}/health

### Plain number array
POST {{host}}/chart
Content-Type: application/json

{
  "data": [1, 3, 2, 5, 4]
}

### Named columns
POST {{host}}/chart
Content-Type: application/json

{
  "data": {
    "date": ["2026-11-01", "2026-11-02", "2026-11-03"],
    "price": [100.5, 101.25, 99.75],
    "volume": [1200, 1500, 1100]
  }
}

### Rows of objects
POST {{host}}/chart
Content-Type: application/json

{
  "data": [
    { "category": "apples", "count": 4 },
    { "category": "pears", "count": 7 },
    { "category": "oranges", "count": 2 }
  ]
}

### CSV
POST {{host}}/chart
Content-Type: text/csv

date,price
2026-11-03,101.2
2026-11-04,102

### Hints
POST {{host}}/chart
Content-Type: application/json

{
  "data": [1, 3, 2, 5, 4],
  "hints": { "type": "bar", "title": "Numbers", "theme": "dark" }
}

### CSV hint in the query string
POST {{host}}/chart?type=line&title=Prices
Content-Type: text/csv

price
1
3
2

### Explain
POST {{host}}/chart/explain
Content-Type: application/json

{
  "data": [1, 3, 2, 5, 4]
}

### Unknown hint
POST {{host}}/chart
Content-Type: application/json

{
  "data": [1, 2, 3],
  "hints": { "colour": "red" }
}

### Reconciliation: list the views
GET {{host}}/recon/views

### Reconciliation: sample request for a view
GET {{host}}/recon/dumbbell/sample

### Reconciliation: the smallest request
POST {{host}}/recon/dumbbell
Content-Type: application/json

{
  "records": [
    { "key": "A-1", "left": 100, "right": 100 },
    { "key": "A-2", "left": 250, "right": 262.5 },
    { "key": "A-3", "left": 80 },
    { "key": "A-4", "right": 45 }
  ]
}

### Reconciliation: names, fields, tolerance, theme
POST {{host}}/recon/dumbbell
Content-Type: application/json

{
  "left": { "name": "Purchase order lines", "short": "Ordered" },
  "right": { "name": "Supplier invoice lines", "short": "Invoiced" },
  "unit": { "one": "line", "many": "lines" },
  "tolerance": 2,
  "fields": [
    { "key": "qty", "label": "Quantity", "decimals": 0, "compare": false },
    { "key": "ext", "label": "Extended amount", "decimals": 2 }
  ],
  "measure": "ext",
  "records": [
    { "key": "PO-5512-2", "name": "Corner boards", "group": "Tidewell Supply", "left": { "qty": 400, "ext": 1240 }, "right": { "qty": 400, "ext": 1380 }, "reason": "Invoiced at 3.45 each. The order says 3.10." },
    { "key": "PO-5530-2", "name": "Label rolls", "group": "Tidewell Supply", "left": { "qty": 150, "ext": 1860 } }
  ],
  "theme": "dark"
}

### Reconciliation: explain
POST {{host}}/recon/dumbbell/explain
Content-Type: application/json

{
  "tolerance": { "percent": 5 },
  "records": [ { "key": "A-2", "left": 250, "right": 262.5 } ]
}

### Reconciliation: unknown option
POST {{host}}/recon/dumbbell
Content-Type: application/json

{
  "records": [ { "key": "A-1", "left": 100 } ],
  "options": { "sortBy": "size" }
}

### Reports: list them
GET {{host}}/reports

### Reports: the sample input
GET {{host}}/reports/sample

### Reports: one that cannot be written (no roles mapped)
POST {{host}}/reports/MO5
Content-Type: application/json

{ "run": { "asOf": "2026-03-31", "profileId": "demo", "roles": {} }, "entries": [], "rows": [] }

### Reports: a small ageing report
POST {{host}}/reports/MO5
Content-Type: application/json

{
  "run": { "asOf": "2026-03-31", "profileId": "demo", "roles": { "Counterparty": "Counterparty", "TradeDate": "TradeDate", "SettleDate": "SettleDate", "Currency": "Currency", "NetCash": "NetCash" } },
  "entries": [
    { "id": "a1", "alignment": "LeftOnly", "outcome": "NotCompared", "left": ["L-1"], "ours": { "Counterparty": "BAML", "TradeDate": "2026-03-25", "SettleDate": "2026-03-27", "Currency": "USD", "NetCash": 125000 }, "committedBy": "P1" },
    { "id": "a2", "alignment": "RightOnly", "outcome": "NotCompared", "right": ["R-1"], "theirs": { "Counterparty": "GS", "TradeDate": "2026-03-30", "SettleDate": "2026-04-01", "Currency": "EUR", "NetCash": 88000 }, "committedBy": "P1" }
  ],
  "rows": [
    { "source": "left", "rowKey": "L-1", "disposition": "LeftOnly", "entryId": "a1" },
    { "source": "right", "rowKey": "R-1", "disposition": "RightOnly", "entryId": "a2" }
  ]
}

### Reports: the same input, as computed values
POST {{host}}/reports/MO5/data
Content-Type: application/json

{ "run": { "asOf": "2026-03-31", "profileId": "demo", "roles": { "TradeDate": "TradeDate", "SettleDate": "SettleDate" } }, "entries": [ { "id": "a1", "alignment": "LeftOnly", "outcome": "NotCompared", "left": ["L-1"], "ours": { "TradeDate": "2026-03-25", "SettleDate": "2026-03-27" }, "committedBy": "P1" } ], "rows": [ { "source": "left", "rowKey": "L-1", "disposition": "LeftOnly", "entryId": "a1" } ] }
