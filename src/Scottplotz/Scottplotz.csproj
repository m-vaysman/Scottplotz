<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Scottplotz</RootNamespace>
    <AssemblyName>Scottplotz</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot" Version="5.1.59" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\NotoSans-Regular.ttf">
      <LogicalName>Scottplotz.Fonts.NotoSans-Regular.ttf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Fonts\NotoSans-Bold.ttf">
      <LogicalName>Scottplotz.Fonts.NotoSans-Bold.ttf</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
